# Copy this file to .env.candidate, set permissions to 600, and replace every value.
# Use a real DNS name pointed at the candidate host, with inbound TCP 80/443 available.
APP_DOMAIN=votes-candidate.example.org

# Generate both secrets with: openssl rand -hex 32
# Hex avoids URL-escaping problems in DATABASE_URL.
POSTGRES_DB=asdmr_candidate
POSTGRES_USER=asdmr_candidate
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MODERATOR_ACCESS_TOKEN=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
