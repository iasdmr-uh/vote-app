# scripts/lan.sh preparar creates .env.lan with random secrets; you do not need to copy this file by hand.
POSTGRES_DB=asdmr_lan
POSTGRES_USER=asdmr_lan
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MODERATOR_ACCESS_TOKEN=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
# Written by scripts/lan.sh iniciar: the laptop's address on the Starlink Wi-Fi.
LAN_ADDRESS=
ALLOW_START_WITH_PENDING_VOTE_CLEANUP=false
