generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  union
  association
}

enum AssemblyStatus {
  preparing
  lobby_open
  lobby_closed
  in_progress
  completed
}

enum ParticipantStatus {
  active
  removed
  left
}

enum RoundStatus {
  draft
  open
  closed
  published
  annulled
}

enum RoundCategory {
  office
  committee
  decision
}

enum PositionGroup {
  board
  department
}

model Organization {
  id         String           @id @default(uuid()) @db.Uuid
  name       String
  type       OrganizationType
  assemblies Assembly[]
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("organizations")
}

model Assembly {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  /** Term the elected serve, e.g. "2027–2029"; shown on the acta and the projector. */
  period         String?
  status         AssemblyStatus       @default(preparing)
  joinCodeHash   String               @unique @map("join_code_hash") @db.Char(64)
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  /** «Presentar oficiales» on the projector (#48): whether it is on, and its slide (0 cover, 1 board, 2 departments). */
  presentationActive Boolean          @default(false) @map("presentation_active")
  presentationSlide  Int              @default(0) @map("presentation_slide")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participants   ParticipantSession[]
  rounds         Round[]
  positions      Position[]
  auditEvents    AuditEvent[]

  @@index([organizationId, status])
  @@map("assemblies")
}

model ParticipantSession {
  id             String            @id @default(uuid()) @db.Uuid
  assemblyId     String            @map("assembly_id") @db.Uuid
  firstName      String            @map("first_name")
  lastName       String            @map("last_name")
  tokenHash      String            @unique @map("token_hash") @db.Char(64)
  resumeCodeHash String?           @unique @map("resume_code_hash") @db.Char(64)
  resumeExpiresAt DateTime?        @map("resume_expires_at")
  status         ParticipantStatus @default(active)
  /** Inhabilitado by the mesa: stays in the room and in the majority base, but cannot vote. */
  votingDisabled Boolean           @default(false) @map("voting_disabled")
  isRegionalSecretary Boolean      @default(false) @map("is_regional_secretary")
  joinedAt       DateTime          @default(now()) @map("joined_at")
  assembly       Assembly          @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  participations Participation[]

  @@index([assemblyId, status])
  @@map("participant_sessions")
}

model Round {
  id             String          @id @default(uuid()) @db.Uuid
  assemblyId     String          @map("assembly_id") @db.Uuid
  title          String
  format         String          @default("single_choice")
  category       RoundCategory   @default(office)
  /** Committee only: how many people stay on it; the first vote asks for exactly this many names. */
  memberCount    Int?            @map("member_count")
  /** Exact names a delegate marks in this vote; a runoff asks for the seats still open. */
  electionSeats  Int?             @map("election_seats")
  regionalSecretaryVotes Boolean  @default(false) @map("regional_secretary_votes")
  /** Set on a runoff or repetition: the election's first vote, where the computed official result accumulates. */
  committeeRootRoundId String?    @map("committee_root_round_id") @db.Uuid
  /** Decision only: 'boolean' (A favor / En contra) or 'options' (written by the mesa; one is chosen). */
  decisionFormat String?          @map("decision_format")
  /** Votes needed over the frozen base: 'simple' (more than half) or 'three_quarters' (at least 3/4). */
  approvalRule   String           @default("simple") @map("approval_rule")
  countingRule   Json            @map("counting_rule")
  status         RoundStatus     @default(draft)
  openedAt       DateTime?       @map("opened_at")
  closedAt       DateTime?       @map("closed_at")
  publishedAt    DateTime?       @map("published_at")
  votesUnlinkedAt DateTime?      @map("votes_unlinked_at")
  annulledAt     DateTime?       @map("annulled_at")
  annulReason    String?         @map("annul_reason")
  /** Percentage base frozen when the ballot stops taking votes, so later arrivals cannot change it. */
  eligibleCount  Int?            @map("eligible_count")
  /** Office only, on the election's first vote: the org-chart box its elected fills. Runoffs inherit it from the root. */
  positionId     String?         @map("position_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  assembly       Assembly        @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  position       Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  options        BallotOption[]
  participations Participation[]
  votes          AnonymousVote[]
  officialResult OfficialResult?
  auditEvents    AuditEvent[]
  committeeRoot Round? @relation("committee_rounds", fields: [committeeRootRoundId], references: [id], onDelete: Cascade)
  committeeRounds Round[] @relation("committee_rounds")

  @@index([assemblyId, status])
  @@map("rounds")
}

/** A box of the Unión Hondureña org chart: the junta directiva and the departamentos. */
model Position {
  id         String        @id @default(uuid()) @db.Uuid
  assemblyId String        @map("assembly_id") @db.Uuid
  group      PositionGroup
  label      String
  sortOrder  Int           @map("sort_order")
  /** Added by the mesa during the Asamblea, not one of the defaults. */
  custom     Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at")
  assembly   Assembly      @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  rounds     Round[]

  @@unique([assemblyId, label])
  @@index([assemblyId, group, sortOrder])
  @@map("positions")
}

model OfficialResult {
  id          String                 @id @default(uuid()) @db.Uuid
  roundId     String                 @unique @map("round_id") @db.Uuid
  note        String?
  actorRef    String                 @map("actor_ref")
  declaredAt  DateTime               @default(now()) @map("declared_at")
  publishedAt DateTime?              @map("published_at")
  round       Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  options     OfficialResultOption[]

  @@map("official_results")
}

model OfficialResultOption {
  officialResultId String         @map("official_result_id") @db.Uuid
  optionId         String         @map("option_id") @db.Uuid
  seatOrder        Int            @map("seat_order")
  officialResult   OfficialResult @relation(fields: [officialResultId], references: [id], onDelete: Cascade)
  option           BallotOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([officialResultId, optionId])
  @@map("official_result_options")
}

model BallotOption {
  id              String                 @id @default(uuid()) @db.Uuid
  roundId         String                 @map("round_id") @db.Uuid
  label           String
  order           Int
  /** Added by the mesa to a runoff from the 3rd vote on; it was not on the vote that prepared it. */
  isNew           Boolean                @default(false) @map("is_new")
  round           Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  votes           AnonymousVote[]
  officialResults OfficialResultOption[]

  @@unique([roundId, order])
  @@unique([roundId, id])
  @@map("ballot_options")
}

model Participation {
  id                   String             @id @default(uuid()) @db.Uuid
  roundId              String             @map("round_id") @db.Uuid
  participantSessionId String             @map("participant_session_id") @db.Uuid
  recordedAt           DateTime           @default(now()) @map("recorded_at")
  round                Round              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantSession   ParticipantSession @relation(fields: [participantSessionId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantSessionId])
  @@map("participations")
}

model AnonymousVote {
  id       String       @id @default(uuid()) @db.Uuid
  roundId  String       @map("round_id") @db.Uuid
  optionId String       @map("option_id") @db.Uuid
  round    Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  option   BallotOption @relation(fields: [roundId, optionId], references: [roundId, id], onDelete: Cascade)

  @@index([roundId, optionId])
  @@map("anonymous_votes")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  assemblyId String   @map("assembly_id") @db.Uuid
  roundId    String?  @map("round_id") @db.Uuid
  actorRef   String   @map("actor_ref")
  action     String
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json?
  assembly   Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  round      Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([assemblyId, occurredAt])
  @@map("audit_events")
}
