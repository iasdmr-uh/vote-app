{
  "name": "asdmr-voting-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "engines": { "node": "^22.22.3 || ^24.15.0", "npm": ">=10" },
  "scripts": {
    "dev": "npm run dev --workspace @asdmr/web",
    "dev:api": "npm run start:dev --workspace @asdmr/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace @asdmr/api",
    "test:integration": "npm run test:integration --workspace @asdmr/api",
    "test:e2e": "playwright test",
    "test:e2e:real-stack": "node scripts/run-e2e-real-stack.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:scenarios": "npm run test:scenarios --workspace @asdmr/api",
    "test:scenarios:browser": "node scripts/run-scenarios-browser.mjs",
    "test:scenarios:browser:headed": "node scripts/run-scenarios-browser.mjs --headed",
    "test:load": "k6 run tests/load/voting.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
