{
  "name": "asdmr-voting-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "engines": { "node": "^22.22.3 || ^24.15.0", "npm": ">=10" },
  "scripts": {
    "dev": "npm run dev --workspace @asdmr/web",
    "dev:api": "npm run start:dev --workspace @asdmr/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:integration": "node scripts/run-e2e-integration.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "k6 run tests/load/voting.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
